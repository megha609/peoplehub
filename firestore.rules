rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function protectedSuperAdminUids() {
      return ["ZYa131iL8AYn5fAZauhDH5R3ody2","a1Y9aWQ4WVYVx00tEEMJ6bdSfuu2"];
    }

    function signedIn() {
      return request.auth != null;
    }

    function profileCanAccessAll(profile) {
      return profile.role == "Admin"
        || (
          request.auth.uid in protectedSuperAdminUids()
          && profile.role == "SuperAdmin"
        );
    }

    function activeUser() {
      let profileExists = signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      let profile = profileExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};

      return profileExists && profile.active == true;
    }

    function isSuperAdmin() {
      let profileExists = signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      let profile = profileExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};

      return profileExists
        && profile.active == true
        && request.auth.uid in protectedSuperAdminUids()
        && profile.role == "SuperAdmin";
    }

    function isAdmin() {
      let profileExists = signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      let profile = profileExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};

      return profileExists
        && profile.active == true
        && profileCanAccessAll(profile);
    }

    function validLegacyGodown(godown) {
      return godown in [
        "CEMENT",
        "PAINTS",
        "HARDWARE",
        "STEEL",
        "ROOFING SHEETS",
        "TILE & SANITARY",
        "TILE2, SANITARY & TIMBER (LOCAL)",
        "TILE2, SANITARY & TIMBER (IMPORTED)",
        "TIMBER WORKSHOP"
      ];
    }

    function validCatalogId(catalogId) {
      return catalogId is string
        && catalogId.matches("^[a-z0-9][a-z0-9-]{0,63}$");
    }

    function validCatalogEntryData(entry) {
      return entry is map
        && entry.keys().hasAll(["name", "active"])
        && entry.keys().hasOnly(["name", "active", "legacyAliases"])
        && entry.name is string
        && entry.name.size() <= 100
        && entry.name.matches(".*[^[:space:]].*")
        && entry.active is bool
        && (
          !entry.keys().hasAny(["legacyAliases"])
          || (
            entry.legacyAliases is list
            && entry.legacyAliases.size() <= 20
          )
        );
    }

    function catalogReferenceValid(
      catalogName,
      catalogId,
      name,
      requireActive
    ) {
      let catalogPath =
        /databases/$(database)/documents/settings/catalogs;
      let catalogExists = exists(catalogPath);
      let catalogData = catalogExists ? get(catalogPath).data : {};
      let entries = catalogData.get(catalogName, {});
      let entry = entries is map && validCatalogId(catalogId)
      ? entries.get(catalogId, {})
      : {};

      return catalogExists
        && entries is map
        && validCatalogId(catalogId)
        && catalogId in entries
        && validCatalogEntryData(entry)
        && (!requireActive || entry.active == true)
        && name is string
        && (
          entry.name == name
          || (
            entry.keys().hasAny(["legacyAliases"])
            && entry.legacyAliases is list
            && name in entry.legacyAliases
          )
        );
    }

    function catalogEntryMatchesName(catalogName, catalogId, name) {
      return catalogReferenceValid(catalogName, catalogId, name, false);
    }

    function staffCanAccessGodown(profile, godown, godownId) {
      return profile.role == "Staff"
        && (
          profile.keys().hasAny(["godownId"])
          ? (
            godownId is string
            ? profile.godownId == godownId
            : profile.godown == godown
              || catalogEntryMatchesName(
                "godowns",
                profile.godownId,
                godown
              )
          )
          : profile.godown == godown
        );
    }

    function validActiveCatalogEntry(catalogName, catalogId, name) {
      return catalogReferenceValid(catalogName, catalogId, name, true);
    }

    function validCatalogReference(data, catalogName, fieldName, labelField) {
      return !data.keys().hasAny([fieldName])
        || catalogEntryMatchesName(
          catalogName,
          data[fieldName],
          data[labelField]
        );
    }

    function validGodownAssignment(data) {
      return data.godown is string
        && data.godown.size() > 0
        && data.keys().hasAny(["godownId"])
        && catalogReferenceValid(
          "godowns",
          data.godownId,
          data.godown,
          true
        );
    }

    function validExistingGodownAssignment(data) {
      return data.godown is string
        && data.godown.size() > 0
        && (
          data.keys().hasAny(["godownId"])
          ? catalogReferenceValid(
              "godowns",
              data.godownId,
              data.godown,
              false
            )
          : validLegacyGodown(data.godown)
        );
    }

    function validJobRoleAssignment(data) {
      return data.role is string
        && data.role.size() > 0
        && (
          !data.keys().hasAny(["jobRoleId"])
          || catalogReferenceValid(
            "jobRoles",
            data.jobRoleId,
            data.role,
            false
          )
        );
    }

    function validOptionalCatalogId(
      data,
      catalogName,
      fieldName,
      labelField
    ) {
      return !data.keys().hasAny([fieldName])
        || catalogReferenceValid(
          catalogName,
          data[fieldName],
          data[labelField],
          true
        );
    }

    function validRetainedCatalogId(
      data,
      existingData,
      catalogName,
      fieldName,
      labelField
    ) {
      return existingData.keys().hasAny([fieldName])
        ? data.keys().hasAny([fieldName])
          && catalogReferenceValid(
            catalogName,
            data[fieldName],
            data[labelField],
            existingData[fieldName] != data[fieldName]
          )
        : validOptionalCatalogId(
            data,
            catalogName,
            fieldName,
            labelField
          );
    }

    function validRetainedGodownAssignment(data, existingData) {
      return data.keys().hasAny(["godownId"])
        ? validRetainedCatalogId(
            data,
            existingData,
            "godowns",
            "godownId",
            "godown"
          )
        : existingData.keys().hasAny(["godownId"])
          ? false
          : data.godown == existingData.godown;
    }

    function validRetainedOptionalCatalogId(
      data,
      existingData,
      catalogName,
      fieldName,
      labelField
    ) {
      return !data.keys().hasAny([fieldName])
        || catalogReferenceValid(
          catalogName,
          data[fieldName],
          data[labelField],
          !(
            existingData.keys().hasAny([fieldName])
            && existingData[fieldName] == data[fieldName]
          )
        );
    }

    function validNewAccountGodownId(data) {
      return data.role == "Admin"
        ? !data.keys().hasAny(["godownId"])
        : data.role == "Staff" && validGodownAssignment(data);
    }

    function validRetainedAccountGodownId(data, existingData) {
      return data.role == "Admin"
        ? !data.keys().hasAny(["godownId"])
        : data.role == "Staff"
          && (
            existingData.keys().hasAny(["godownId"])
            ? validRetainedCatalogId(
                data,
                existingData,
                "godowns",
                "godownId",
                "godown"
              )
            : data.keys().hasAny(["godownId"])
              ? validOptionalCatalogId(
                  data,
                  "godowns",
                  "godownId",
                  "godown"
                )
              : data.godown == existingData.godown
          );
    }

    function validAccountAccess(data) {
      return data.keys().hasAll(["role", "active", "godown"])
        && data.role in ["Admin", "Staff"]
        && data.active is bool
        && (
          (
            data.role == "Admin"
            && data.godown == null
            && !data.keys().hasAny(["godownId"])
          )
          || (
            data.role == "Staff"
            && validExistingGodownAssignment(data)
          )
        );
    }

    function canAccessEmployeeAssignment(data) {
      let profileExists = signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      let profile = profileExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};

      return profileExists
        && profile.active == true
        && (
          profileCanAccessAll(profile)
          || (
            employeeHasGodownAssignment(data)
            && !employeeHasDepartmentAssignment(data)
            && staffCanAccessGodown(
              profile,
              data.get("godown", null),
              data.get("godownId", null)
            )
          )
        );
    }

    function validEmployee(employeeData) {
  return employeeData.keys().hasAll([
      'name', 'role', 'status',
      'createdAt', 'updatedAt'
    ])
    && employeeData.keys().hasOnly([
      'name', 'role', 'godown', 'status',
      'createdAt', 'updatedAt', 'godownId', 'jobRoleId',
      'departmentId', 'department'
    ])
    && employeeData.name is string
    && employeeData.name.size() > 0
    && employeeData.role is string
    && employeeData.role.size() > 0
    && employeeData.status in ['Active', 'Inactive']
    && employeeData.createdAt is timestamp
    && employeeData.updatedAt is timestamp
    && (
      !employeeData.keys().hasAny(["departmentId", "department"])
      || employeeData.keys().hasAll(["departmentId", "department"])
        && employeeData.department is string
        && employeeData.department.size() > 0
    );
}

    function validEmployeeBase(employeeData) {
      return employeeData.keys().hasAll([
          'name', 'role', 'status',
          'createdAt', 'updatedAt'
        ])
        && employeeData.keys().hasOnly([
          'name', 'role', 'godown', 'status',
          'createdAt', 'updatedAt', 'godownId', 'jobRoleId',
          'departmentId', 'department'
        ])
        && employeeData.name is string
        && employeeData.name.size() > 0
        && employeeData.status in ['Active', 'Inactive']
        && employeeData.createdAt is timestamp
        && employeeData.updatedAt is timestamp
        && (
          !employeeData.keys().hasAny(["departmentId", "department"])
          || employeeData.keys().hasAll(["departmentId", "department"])
            && employeeData.department is string
            && employeeData.department.size() > 0
        );
    }

    function employeeHasGodownAssignment(data) {
      return data.keys().hasAny(["godown", "godownId"]);
    }

    function employeeHasDepartmentAssignment(data) {
      return data.keys().hasAny(["departmentId", "department"]);
    }

    function validEmployeeAssignmentShape(data) {
      return employeeHasGodownAssignment(data)
          != employeeHasDepartmentAssignment(data)
        && (
          employeeHasGodownAssignment(data)
          ? data.keys().hasAny(["godown"])
            && data.godown is string
            && data.godown.size() > 0
            && (
              !data.keys().hasAny(["godownId"])
              || data.godownId is string
                && data.godownId.size() > 0
            )
          : data.keys().hasAll(["departmentId", "department"])
            && !data.keys().hasAny(["godown", "godownId"])
            && data.department is string
            && data.department.size() > 0
        );
    }

    function validNewEmployeeAssignment(data) {
      return validEmployeeAssignmentShape(data)
        && (
          employeeHasGodownAssignment(data)
          ? data.keys().hasAny(["godownId"])
            && validActiveCatalogEntry(
              "godowns",
              data.godownId,
              data.godown
            )
          : validActiveCatalogEntry(
              "departments",
              data.departmentId,
              data.department
            )
        );
    }

    function validRetainedEmployeeAssignment(data, existingData) {
      return validEmployeeAssignmentShape(data)
        && (
          employeeHasGodownAssignment(data)
          ? existingData.keys().hasAny(["godown"])
            ? validRetainedGodownAssignment(data, existingData)
            : validGodownAssignment(data)
          : existingData.keys().hasAny(["departmentId"])
            ? validRetainedOptionalCatalogId(
                data,
                existingData,
                "departments",
                "departmentId",
                "department"
              )
            : validOptionalCatalogId(
                data,
                "departments",
                "departmentId",
                "department"
              )
        );
    }

    function validNewEmployeeJobRole(employeeData) {
      return employeeData.keys().hasAny(["jobRoleId"])
        && validActiveCatalogEntry(
          "jobRoles",
          employeeData.jobRoleId,
          employeeData.role
        );
    }

    function attendanceDepartmentUnchanged(data, existingData) {
      return data.get("departmentId", null)
          == existingData.get("departmentId", null)
        && data.get("departmentName", null)
          == existingData.get("departmentName", null);
    }

    function attendanceHasGodownAssignment(data) {
      return data.keys().hasAny(["godown", "godownId"]);
    }

    function attendanceHasDepartmentAssignment(data) {
      return data.keys().hasAny(["departmentId", "departmentName"]);
    }

    function validAttendanceAssignmentSnapshot(data) {
      return (
          attendanceHasGodownAssignment(data)
          != attendanceHasDepartmentAssignment(data)
        )
        && (
          !attendanceHasGodownAssignment(data)
          || data.keys().hasAny(["godown"])
            && data.godown is string
            && data.godown.size() > 0
            && (
              !data.keys().hasAny(["godownId"])
              || validCatalogId(data.godownId)
            )
        )
        && (
          !attendanceHasDepartmentAssignment(data)
          || data.keys().hasAll(["departmentId", "departmentName"])
            && validCatalogId(data.departmentId)
            && data.departmentName is string
            && data.departmentName.size() > 0
        );
    }



    function attendanceMatchesEmployee(data) {
      let employeePath =
        /databases/$(database)/documents/employees/$(data.employeeId);
      let employeeExists = exists(employeePath);
      let employee = employeeExists ? get(employeePath).data : {};

      return employeeExists
        && employee.status == "Active"
        && employee.name == data.employeeName
        && validEmployeeAssignmentShape(employee)
        && (
          employee.keys().hasAny(["jobRoleId"])
          ? employee.jobRoleId == data.get("jobRoleId", null)
          : employee.role == data.role
        )
        && (
          employeeHasGodownAssignment(employee)
          ? attendanceHasGodownAssignment(data)
            && !attendanceHasDepartmentAssignment(data)
            && employee.godown == data.godown
            && validExistingGodownAssignment(data)
            && (
              employee.keys().hasAny(["godownId"])
              ? employee.godownId == data.get("godownId", null)
              : true
            )
          : attendanceHasDepartmentAssignment(data)
            && !attendanceHasGodownAssignment(data)
            && employee.departmentId == data.departmentId
            && employee.department == data.departmentName
            && catalogEntryMatchesName(
              "departments",
              employee.departmentId,
              employee.department
            )
        );
    }

    function validStatus(status) {
      return status in [
        "Present",
        "Absent",
        "Sick",
        "On Leave",
        "Overtime"
      ];
    }

    function validAttendanceDate(date) {
      return date is string
        && date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$");
    }

    function hasAttendanceFields(data) {
      return data.keys().hasAll([
          "employeeId",
          "employeeName",
          "role",
          "date",
          "status",
          "updatedBy",
          "updatedByUid",
          "updatedAt"
        ])
        && data.keys().hasOnly([
          "employeeId",
          "employeeName",
          "role",
          "godown",
          "date",
          "status",
          "updatedBy",
          "updatedByUid",
          "updatedAt",
          "createdByUid",
          "lastAuditId",
          "godownId",
          "jobRoleId",
          "departmentId",
          "departmentName"
        ])
        && data.employeeId is string
        && data.employeeName is string
        && validJobRoleAssignment(data)
        && validAttendanceAssignmentSnapshot(data)
        && validAttendanceDate(data.date)
        && validStatus(data.status)
        && data.updatedBy is string
        && data.updatedByUid == request.auth.uid
        && data.updatedAt == request.time;
    }

    function creatorUnchanged() {
      return resource.data.keys().hasAny(["createdByUid"])
        ? request.resource.data.keys().hasAny(["createdByUid"])
          && request.resource.data.createdByUid == resource.data.createdByUid
        : !request.resource.data.keys().hasAny(["createdByUid"]);
    }

    function correctionHasAudit(attendanceId) {
      let auditId = request.resource.data.lastAuditId;
      let auditPath =
        /databases/$(database)/documents/attendanceAudit/$(auditId);
      let auditIdValid = auditId is string;
      let auditExists = auditIdValid && exists(auditPath);
      let auditExistsAfter = auditIdValid && existsAfter(auditPath);
      let audit = auditExistsAfter ? getAfter(auditPath).data : {};

      return auditIdValid
        && !auditExists
        && auditExistsAfter
        && audit.attendanceId == attendanceId
        && audit.previousStatus == resource.data.status
        && audit.newStatus == request.resource.data.status
        && audit.employeeId == request.resource.data.employeeId
        && audit.employeeName == request.resource.data.employeeName
        && audit.get("godown", null)
          == request.resource.data.get("godown", null)
        && audit.get("godownId", null)
          == request.resource.data.get("godownId", null)
        && (
          audit.keys().hasAny(["role"])
          ? audit.role == request.resource.data.role
          : !request.resource.data.keys().hasAny(["jobRoleId"])
        )
        && audit.get("jobRoleId", null)
          == request.resource.data.get("jobRoleId", null)
        && audit.get("departmentId", null)
          == request.resource.data.get("departmentId", null)
        && audit.get("departmentName", null)
          == request.resource.data.get("departmentName", null)
        && audit.date == request.resource.data.date
        && audit.changedBy == request.resource.data.updatedBy
        && audit.changedByUid == request.auth.uid
        && audit.changedAt == request.time;
    }

    function auditHasCorrection(auditId) {
      let attendanceId = request.resource.data.attendanceId;
      let attendancePath =
        /databases/$(database)/documents/attendance/$(attendanceId);
      let attendanceIdValid = attendanceId is string;
      let attendanceExists = attendanceIdValid && exists(attendancePath);
      let attendanceExistsAfter = attendanceIdValid && existsAfter(attendancePath);
      let attendance = attendanceExists
        ? get(attendancePath).data
        : {};
      let attendanceAfter = attendanceExistsAfter
        ? getAfter(attendancePath).data
        : {};

      return attendanceIdValid
        && attendanceExists
        && attendanceExistsAfter
        && attendance.status == request.resource.data.previousStatus
        && attendanceAfter.status == request.resource.data.newStatus
        && attendanceAfter.lastAuditId == auditId
        && attendanceAfter.employeeId == request.resource.data.employeeId
        && attendanceAfter.employeeName == request.resource.data.employeeName
        && attendanceAfter.get("godown", null)
          == request.resource.data.get("godown", null)
        && attendanceAfter.get("godownId", null)
          == request.resource.data.get("godownId", null)
        && (
          request.resource.data.keys().hasAny(["role"])
          ? attendanceAfter.role == request.resource.data.role
          : !attendanceAfter.keys().hasAny(["jobRoleId"])
        )
        && attendanceAfter.get("jobRoleId", null)
          == request.resource.data.get("jobRoleId", null)
        && attendanceAfter.get("departmentId", null)
          == request.resource.data.get("departmentId", null)
        && attendanceAfter.get("departmentName", null)
          == request.resource.data.get("departmentName", null)
        && attendanceAfter.date == request.resource.data.date
        && attendanceAfter.updatedBy == request.resource.data.changedBy
        && attendanceAfter.updatedByUid == request.auth.uid
        && attendanceAfter.updatedAt == request.time;
    }

    function canUseAttendanceAssignment(data) {
      let profileExists = signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
      let profile = profileExists
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};

      return profileExists
        && profile.active == true
        && (
          profileCanAccessAll(profile)
          || (
            attendanceHasGodownAssignment(data)
            && !attendanceHasDepartmentAssignment(data)
            && staffCanAccessGodown(
              profile,
              data.get("godown", null),
              data.get("godownId", null)
            )
          )
        );
    }

    match /settings/{settingId} {
      allow get: if settingId == "catalogs" && activeUser();
      allow list: if false;

      allow create, update: if settingId == "catalogs"
        && isSuperAdmin()
        && request.resource.data.keys().hasAll([
          "schemaVersion",
          "godowns",
          "jobRoles",
          "departments"
        ])
        && request.resource.data.keys().hasOnly([
          "schemaVersion",
          "godowns",
          "jobRoles",
          "departments"
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.godowns is map
        && request.resource.data.jobRoles is map
        && request.resource.data.departments is map
        && (
          !exists(
            /databases/$(database)/documents/settings/catalogs
          )
          || (
            resource.data.godowns is map
            && resource.data.jobRoles is map
            && resource.data.departments is map
            && request.resource.data.godowns.keys().hasAll(
              resource.data.godowns.keys()
            )
            && request.resource.data.jobRoles.keys().hasAll(
              resource.data.jobRoles.keys()
            )
            && request.resource.data.departments.keys().hasAll(
              resource.data.departments.keys()
            )
          )
        );

      allow delete: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() &&
        (request.auth.uid == userId || isSuperAdmin());

      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin()
        && !(userId in protectedSuperAdminUids())
        && validAccountAccess(request.resource.data)
        && validNewAccountGodownId(request.resource.data)
        && request.resource.data.keys().hasAll([
          "email",
          "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "role",
          "active",
          "godown",
          "godownId",
          "email",
          "createdAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.createdAt == request.time;

      allow update: if isSuperAdmin()
        && !(userId in protectedSuperAdminUids())
        && userId != request.auth.uid
        && validAccountAccess(request.resource.data)
        && validRetainedAccountGodownId(
          request.resource.data,
          resource.data
        )
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "role",
          "godown",
          "godownId",
          "active"
        ]);

      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if canAccessEmployeeAssignment(resource.data);

      allow create: if isAdmin() &&
        validEmployeeBase(request.resource.data)
        && validNewEmployeeAssignment(request.resource.data)
        && validNewEmployeeJobRole(request.resource.data);

      allow update: if isAdmin()
        && validEmployee(request.resource.data)
        && validRetainedEmployeeAssignment(
          request.resource.data,
          resource.data
        )
        && validRetainedCatalogId(
          request.resource.data,
          resource.data,
          "jobRoles",
          "jobRoleId",
          "role"
        )
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSuperAdmin();
    }

    match /attendance/{attendanceId} {
      allow get, list: if canUseAttendanceAssignment(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "employeeId",
          "employeeName",
          "role",
          "godown",
          "date",
          "status",
          "updatedBy",
          "updatedByUid",
          "updatedAt",
          "createdByUid",
          "godownId",
          "jobRoleId",
          "departmentId",
          "departmentName"
        ])
        && hasAttendanceFields(request.resource.data)
        && request.resource.data.keys().hasAll(["createdByUid"])
        && request.resource.data.createdByUid == request.auth.uid
        && canUseAttendanceAssignment(request.resource.data)
        && attendanceMatchesEmployee(request.resource.data);

      allow update: if signedIn()
        && hasAttendanceFields(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedBy",
          "updatedByUid",
          "updatedAt",
          "lastAuditId"
        ])
        && request.resource.data.status != resource.data.status
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.employeeName == resource.data.employeeName
        && request.resource.data.role == resource.data.role
        && request.resource.data.get("godown", null)
          == resource.data.get("godown", null)
        && request.resource.data.get("godownId", null)
          == resource.data.get("godownId", null)
        && request.resource.data.date == resource.data.date
        && attendanceDepartmentUnchanged(
          request.resource.data,
          resource.data
        )
        && creatorUnchanged()
        && canUseAttendanceAssignment(resource.data)
        && correctionHasAudit(attendanceId);

      allow delete: if false;
    }

    match /attendanceAudit/{auditId} {
      allow get, list: if canUseAttendanceAssignment(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "attendanceId",
          "previousStatus",
          "newStatus",
          "employeeId",
          "employeeName",
          "role",
          "godown",
          "date",
          "changedBy",
          "changedByUid",
          "changedAt",
          "godownId",
          "jobRoleId",
          "departmentId",
          "departmentName"
        ])
        && request.resource.data.keys().hasAll([
          "attendanceId",
          "previousStatus",
          "newStatus",
          "employeeId",
          "employeeName",
          "date",
          "changedBy",
          "changedByUid",
          "changedAt"
        ])
        && validStatus(request.resource.data.previousStatus)
        && validStatus(request.resource.data.newStatus)
        && request.resource.data.previousStatus != request.resource.data.newStatus
        && request.resource.data.attendanceId is string
        && request.resource.data.employeeId is string
        && request.resource.data.employeeName is string
        && validAttendanceDate(request.resource.data.date)
        && request.resource.data.changedBy is string
        && request.resource.data.changedByUid == request.auth.uid
        && request.resource.data.changedAt == request.time
        && validAttendanceAssignmentSnapshot(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(["jobRoleId"])
          || (
            request.resource.data.keys().hasAny(["role"])
            && validCatalogReference(
              request.resource.data,
              "jobRoles",
              "jobRoleId",
              "role"
            )
          )
        )
        && canUseAttendanceAssignment(request.resource.data)
        && auditHasCorrection(auditId);

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
